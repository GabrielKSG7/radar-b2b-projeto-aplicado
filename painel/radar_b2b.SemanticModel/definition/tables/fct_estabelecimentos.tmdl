table fct_estabelecimentos
	lineageTag: c17cbd3c-d9e0-4271-9f69-9237d91b952e

	measure Ativos = COUNTROWS ( fct_estabelecimentos )
		formatString: #,0
		lineageTag: 8e6f1b1b-6e97-45bd-b055-adf8b7fe0085

	measure 'Abertos na janela' = CALCULATE ( [Ativos], fct_estabelecimentos[fl_aberto_na_janela] = TRUE () )
		formatString: #,0
		lineageTag: 87a916c5-c5fb-4a83-b048-a76257ba27cd

	measure Oportunidades = CALCULATE ( [Ativos], fct_estabelecimentos[fl_icp] = TRUE () )
		formatString: #,0
		lineageTag: f75ea901-b249-4c3b-b30f-e0bf2c21522c

	measure 'Oportunidades Faixa A' = CALCULATE ( [Oportunidades], fct_estabelecimentos[faixa_prioridade] = "A" )
		formatString: #,0
		lineageTag: 7508e5f9-9ac6-4ab6-8153-5a90eca99c9c

	measure 'Sem contador identificado' = CALCULATE ( [Oportunidades], fct_estabelecimentos[fl_email_contabilidade] = FALSE () )
		formatString: #,0
		lineageTag: e65d3b81-96aa-46b3-9bfc-d27b0a15cb9c

	measure '% do mercado ativo' = DIVIDE ( [Oportunidades], [Ativos] )
		formatString: 0.0%
		lineageTag: e8dc5e59-ae50-4a3f-8270-72eb2ac9c91e

	measure 'Score medio' = CALCULATE ( AVERAGE ( fct_estabelecimentos[score] ), fct_estabelecimentos[fl_icp] = TRUE () )
		formatString: 0.0
		lineageTag: 60179590-79d4-4eb9-bafc-dcb422c45ca8

	measure 'Base de referencia' = "Base da Receita com aberturas até " & FORMAT ( MAX ( fct_estabelecimentos[data_referencia] ), "dd/mm/yyyy" )
		lineageTag: 8453e174-9f74-4364-9cb2-30c71959b363

