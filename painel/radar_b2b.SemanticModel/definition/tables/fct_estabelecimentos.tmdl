				    Tipos = Table.TransformColumnTypes(Fonte, {{"cnpj", type text}, {"municipio_cod", type text}, {"cnae_cod", type text}, {"porte_cod", type text}, {"data_inicio_atividade", type date}, {"cnpj_formatado", type text}, {"razao_social", type text}, {"nome_fantasia", type text}, {"municipio", type text}, {"bairro", type text}, {"telefone_1", type text}, {"email", type text}, {"natureza_juridica", type text}, {"matriz_filial", type text}, {"regime_tributario", type text}, {"capital_social", type number}, {"qtd_cnaes_secundarios", Int64.Type}, {"dias_desde_abertura", Int64.Type}, {"meses_desde_abertura", Int64.Type}, {"ano_mes_abertura", type text}, {"fl_aberto_na_janela", type logical}, {"fl_mei", type logical}, {"fl_natureza_empresarial", type logical}, {"fl_cnae_excluido", type logical}, {"fl_matriz", type logical}, {"fl_sociedade", type logical}, {"fl_email_contabilidade", type logical}, {"empresas_mesmo_email", Int64.Type}, {"fl_icp", type logical}, {"etapa_funil", type text}, {"pts_recencia", type number}, {"pts_regime", Int64.Type}, {"pts_porte", Int64.Type}, {"pts_capital", Int64.Type}, {"pts_sociedade", Int64.Type}, {"pts_complexidade", Int64.Type}, {"pts_contato", type number}, {"pts_penalidade_contador", Int64.Type}, {"score", type number}, {"faixa_prioridade", type text}, {"ranking", Int64.Type}, {"ranking_municipio", Int64.Type}, {"motivos", type text}, {"data_referencia", type date}, {"competencia", type text}})
				in
